# Backend NestJS + PostgreSQL
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/NOMBRE_BD?schema=public"
ENTORNO="desarrollo"
PORT=8000
URL_PUBLICA="http://localhost:8000"
CORS_ORIGENES="http://localhost:3005,http://localhost:3000"

# Autenticacion
JWT_SECRETO="cambia-esta-clave-por-un-secreto-largo-y-unico-de-32-caracteres"
JWT_DURACION="7d"

# Reservas / alcance de venta
RESERVA_HOLD_MINUTOS=20
IDIOMAS_SITIO="es,en"
MONEDAS_HABILITADAS="PEN,USD"
CANALES_RESERVA="ONLINE,WHATSAPP"
CANALES_RESERVA_TRANSPORTES="ONLINE,WHATSAPP"
CANALES_RESERVA_TOURS="ONLINE,WHATSAPP"
CANALES_RESERVA_EVENTOS="WHATSAPP"
WHATSAPP_RESERVAS="519XXXXXXXX"
IZIPAY_HABILITADO=true

# Izipay: sandbox en desarrollo; credenciales de producción entregadas por Izipay.
IZIPAY_AMBIENTE="sandbox"
IZIPAY_USUARIO=""
IZIPAY_CONTRASENA=""
IZIPAY_LLAVE_PUBLICA=""
IZIPAY_LLAVE_SECRETA=""
IZIPAY_URL_NOTIFICACION="http://localhost:8000/api/pagos/izipay/webhook"

# Google Cloud Storage: bucket dedicado solo a medios publicables. En local usa ADC; en producción una cuenta de servicio con acceso al bucket.
GOOGLE_CLOUD_PROJECT="hagemsa-cloud"
GCS_BUCKET_MEDIA="incatravelperu-media-2026"

# Cloudinary legado para comprobantes de pago (no se usa para medios del catálogo).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Correo operativo (Resend)
RESEND_API_KEY=""
CORREO_REMITENTE=""
CORREO_ADMINISTRADOR=""

# Documentos oficiales aprobados por el negocio; HTTPS en producción.
URL_TERMINOS=""
URL_PRIVACIDAD=""
URL_CANCELACIONES=""
VERSION_POLITICAS="2026-01"

# Evidencia externa de preparación operativa antes de producción.
DERECHOS_MEDIOS_VERIFICADOS=false
BACKUP_VERIFICADO=false
MONITOREO_URL=""
RETENCION_HISTORIAL_DIAS=30
RETENCION_AUDITORIA_DIAS=
